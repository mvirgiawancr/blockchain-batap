# Production Environment Variables (Tanpa Domain - Pakai IP)# Production Environment Variables (Tanpa Domain - Pakai IP)

# Ganti YOUR_VPS_IP dengan IP public VPS Anda# Ganti YOUR_VPS_IP dengan IP public VPS Anda

# Contoh: 103.123.45.67# Contoh: 103.123.45.67



VITE_API_URL=http://YOUR_VPS_IP:8000/api/v1VITE_API_URL=http://YOUR_VPS_IP:8000/api/v1

VITE_WS_URL=ws://YOUR_VPS_IP:8000/wsVITE_WS_URL=ws://YOUR_VPS_IP:8000/ws



# Jika sudah setup SSL (HTTPS):# Jika sudah setup SSL (HTTPS):

# VITE_API_URL=https://YOUR_VPS_IP:8000/api/v1# VITE_API_URL=https://YOUR_VPS_IP:8000/api/v1

# VITE_WS_URL=wss://YOUR_VPS_IP:8000/ws# VITE_WS_URL=wss://YOUR_VPS_IP:8000/ws



# Jika menggunakan Nginx reverse proxy pada port 80/443:# Jika menggunakan Nginx reverse proxy pada port 80/443:

# VITE_API_URL=http://YOUR_VPS_IP/api/v1# VITE_API_URL=http://YOUR_VPS_IP/api/v1

# VITE_WS_URL=ws://YOUR_VPS_IP/ws# VITE_WS_URL=ws://YOUR_VPS_IP/ws

