# ═══════════════════════════════════════════════════════════
# LAM-TEK 2025 Backend Environment Variables
# ═══════════════════════════════════════════════════════════

# Server Configuration
PORT=8000
NODE_ENV=development

# CORS Configuration (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ───────────────────────────────────────────────────────────
# Google Gemini AI (REQUIRED)
# ───────────────────────────────────────────────────────────
# Get your API key from: https://makersuite.google.com/app/apikey
# or https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ───────────────────────────────────────────────────────────
# Pinata IPFS (OPTIONAL - for decentralized storage)
# ───────────────────────────────────────────────────────────
# Get your JWT from: https://app.pinata.cloud/ -> API Keys -> Create New Key
# Leave empty to skip IPFS storage
PINATA_JWT=your_pinata_jwt_token_here
PINATA_GATEWAY=gateway.pinata.cloud

# ───────────────────────────────────────────────────────────
# Hyperledger Fabric Configuration
# ───────────────────────────────────────────────────────────
# Make sure Fabric network is running: cd .. && fablo up
FABRIC_MSP_ID=sekretariatMSP
FABRIC_WALLET_PATH=./wallet
FABRIC_CONNECTION_PROFILE=../fablo-target/fabric-config/connection-profiles/connection-profile-sekretariat.json
FABRIC_CHANNEL_NAME=akreditasi
FABRIC_CHAINCODE_NAME=submission-contract
FABRIC_USER_ID=admin
FABRIC_USER_SECRET=adminpw

# ───────────────────────────────────────────────────────────
# PostgreSQL Database (for encryption keys & off-chain data)
# ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=akreditasi
DB_USER=lamtek
DB_PASSWORD=lamtek_secure_2025
DB_MAX_CONNECTIONS=20

# ═══════════════════════════════════════════════════════════
# ⚠️  SETUP INSTRUCTIONS
# ═══════════════════════════════════════════════════════════
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Get Gemini API key (REQUIRED):
#    https://makersuite.google.com/app/apikey
#    Replace "your_gemini_api_key_here" with your actual key
#
# 3. Get Pinata keys (OPTIONAL):
#    https://app.pinata.cloud/
#    Leave empty if you don't want IPFS storage
#
# 4. Start Hyperledger Fabric network:
#    cd ..
#    fablo up
#
# 5. Start the backend server:
#    npm start
#
# 6. Test the API:
#    curl http://localhost:8000/health
# ═══════════════════════════════════════════════════════════
