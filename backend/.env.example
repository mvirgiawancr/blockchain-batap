# ============================================
# Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# For VPS deployment, replace YOUR_VPS_IP with your actual VPS IP address

# ============================================
# Pinata IPFS Configuration (REQUIRED)
# ============================================
PINATA_JWT=your_pinata_jwt_token_here
PINATA_BASE_URL=https://api.pinata.cloud
PINATA_CONNECT_TIMEOUT=10
PINATA_READ_TIMEOUT=60

# ============================================
# Google Gemini AI Configuration (REQUIRED)
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# ============================================
# Hyperledger Fabric Configuration
# ============================================
FABLO_REST_BASE=http://localhost:8800
FABRIC_CHANNEL=akreditasi
FABRIC_CHAINCODE=submission-contract
FABRIC_CONTRACT=SubmissionContract
FABRIC_ORG=OrdererMSP
FABRIC_USER=admin
FABRIC_AUTH_TYPE=basic
FABRIC_AUTH_USERNAME=admin
FABRIC_AUTH_PASSWORD=adminpw
FABRIC_AUTH_TOKEN=

# ============================================
# Backend Configuration
# ============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True

# ============================================
# CORS Configuration
# ============================================
# For local development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# For VPS deployment, add: http://YOUR_VPS_IP:3000
# Example: CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.100:3000

# ============================================
# JWT Secret (for authentication if needed)
# ============================================
JWT_SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
